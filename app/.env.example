# Copy this file to `.env.local` (which git ignores) and fill in the real value.
# EXPO_PUBLIC_ values are bundled into the app, so never put secrets here.
#
# Live store API (docs/APP_TEAM_HANDOVER.md). Prefer this for device / Expo Go:
EXPO_PUBLIC_API_BASE_URL=https://store.jiotechxpert.com/api
#
# Local API only while developing against a laptop server (docs/APP_API_GUIDE.md §3–4):
# iOS simulator:        http://localhost:5001/api
# Android emulator:     http://10.0.2.2:5001/api
# Phone on same Wi-Fi:  http://<this computer's LAN address>:5001/api
#
# After any change: npx expo start -c
