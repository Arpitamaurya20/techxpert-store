# Copy this file to `.env.local` (which git ignores) and fill in the real value.
# EXPO_PUBLIC_ values are bundled into the app, so never put secrets here.
#
# Base URL of the Techxpert authentication API, without a trailing slash.
# Leave empty until the backend is ready; the login screen will then show a
# "not connected" message instead of pretending to sign in.
EXPO_PUBLIC_API_BASE_URL=
