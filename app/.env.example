# Copy this file to `.env.local` (which git ignores) and fill in the real values.
# EXPO_PUBLIC_ values are bundled into the app, so never put secrets here.
#
# Dual host during blue/green (docs/APP_TEAM_PULL_BRIEF.md, docs/BLUE_GREEN.md):
#   BLUE  = browse / CMS / search / wishlist / help
#   GREEN = OTP, session, addresses, cart, delivery, checkout, PayU, green orders
#
EXPO_PUBLIC_API_BASE_URL=https://store.jiotechxpert.com/api
EXPO_PUBLIC_GREEN_API_BASE_URL=https://apitest.jiotechxpert.com/api
#
# PayU on green (off until ops drops carts.UserID FK — server/sql/carts_userid_logical_fk.sql):
# EXPO_PUBLIC_PAYU_ENABLED=1
#
# Optional: public website origin for non-/uploads CMS images
# EXPO_PUBLIC_ASSET_BASE_URL=https://store.jiotechxpert.com
#
# Local API only while developing against a laptop server (docs/APP_API_GUIDE.md §3–4):
# EXPO_PUBLIC_API_BASE_URL=http://localhost:5001/api
# EXPO_PUBLIC_GREEN_API_BASE_URL=http://localhost:5001/api
# Android emulator: use http://10.0.2.2:5001/api
#
# After any change: npx expo start -c
