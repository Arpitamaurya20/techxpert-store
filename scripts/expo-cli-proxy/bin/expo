#!/usr/bin/env node
'use strict';

const { spawnSync } = require('child_process');
const fs = require('fs');
const path = require('path');

const appDir = path.resolve(__dirname, '..', '..', '..', 'app');
const cli = path.join(appDir, 'node_modules', 'expo', 'bin', 'cli');

if (!fs.existsSync(cli)) {
  console.error(
    'Expo is not installed in app/.\nRun:  cd app && npm install\nThen: npx expo start'
  );
  process.exit(1);
}

const result = spawnSync(process.execPath, [cli, ...process.argv.slice(2)], {
  cwd: appDir,
  stdio: 'inherit',
  env: process.env,
});

process.exit(result.status === null ? 1 : result.status);
