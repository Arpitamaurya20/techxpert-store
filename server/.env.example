# Techxpert Store API — copy to .env and adjust

PORT=5001

# Shared MySQL host (both schemas on the same instance — see docs/ARCHITECTURE.md §4)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me

# Dual-database names
# Login / OTP / addresses / admin_users
DB_USERS=homecare
# Catalog / orders / carts / CMS / pricing / audit
DB_STORE=techxpertstore

# Public origin for rewriting relative banner image paths (/images/…) for mobile (L5)
# ASSET_BASE_URL=http://localhost:5173

# Auth
# JWT_SECRET=change-me-to-a-long-random-string
# Local seed admin (admin@techxpert.in / admin123) — never in production
ALLOW_DEV_ADMIN=1

# Optional: serve server/database.json when MySQL is down (local demo only)
# ALLOW_FILE_STORE=1

# Production: comma-separated portal origins
# CORS_ORIGINS=https://admin.example.com
# NODE_ENV=production
