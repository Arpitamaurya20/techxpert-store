# Techxpert Store API — copy to .env and adjust

PORT=5001
# On the VPS only — keep Node off the public interface; Apache proxies to it:
# HOST=127.0.0.1

# Shared MySQL host (both schemas on the same instance — see docs/ARCHITECTURE.md §4)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me

# Dual-database names
# Login / OTP / addresses / admin_users
DB_USERS=homecare
# Catalog / orders / carts / CMS / pricing / audit
DB_STORE=techxpertstore

# Public origin of this API. Product pictures become full addresses with this.
# Locally the API defaults to http://localhost:5001 when this is unset.
# PUBLIC_API_ORIGIN=http://localhost:5001

# Public origin for rewriting relative banner image paths (/images/…) for mobile (L5)
# ASSET_BASE_URL=http://localhost:5173

# Auth
# JWT_SECRET=change-me-to-a-long-random-string
# Local seed admin (admin@techxpert.in / admin123) — never in production
ALLOW_DEV_ADMIN=1

# Optional: serve server/database.json when MySQL is down (local demo only)
# ALLOW_FILE_STORE=1

# Production: comma-separated portal origins
# CORS_ORIGINS=https://admin.example.com
# NODE_ENV=production

# Sign-in codes. Leave these unset on a development machine.
# The local code is always 123456 and is not texted. Do not set NODE_ENV=production locally.
# Production uses Homecare's sign-in template, never PRP_ORDER_TEMPLATE_NAME.
# OTP_SMS_PROVIDER=prp
# PRP_SMS_TEMPLATE_NAME=TECHXPERT OTP

# Order confirmation uses the same text service as Homecare, with its own template.
# It stays off until staff choose it on Shop settings. Do not point this at the sign-in template.
# ORDER_SMS_PROVIDER=prp
# PRP_SMS_API_KEY=
# PRP_SMS_SENDER=TECHX
# PRP_ORDER_TEMPLATE_NAME=
# ORDER_WHATSAPP_PROVIDER=chatmybot
# CHATMYBOT_ACCESS_TOKEN=
# CHATMYBOT_ORDER_TEMPLATE_ID=
# INTERAKT_API_KEY=
# INTERAKT_ORDER_TEMPLATE=
